{
  "model": "opus",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(__TARGET__/**)",
      "Read(__ROOT__/**)",
      "Read(__SKILL__/**)",
      "Read(__LINK__/**)",
      "Read(~/.claude/agents/sec-lean-*)",
      "Glob",
      "Grep",
      "TodoWrite",
      "Agent(sec-lean-recon)",
      "Agent(sec-lean-hunter)",
      "Agent(sec-lean-critic)",
      "Agent(sec-lean-verifier)",
      "Agent(sec-lean-batch-verifier)",
      "Write(__ROOT__/**)",
      "Edit(__ROOT__/**)",
      "Bash(rg:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff --name-only:*)",
      "Bash(git -C __TARGET__ ls-files:*)",
      "Bash(git -C __TARGET__ rev-parse:*)",
      "Bash(git -C __TARGET__ log:*)",
      "Bash(git -C __TARGET__ status:*)",
      "Bash(git -C __TARGET__ diff --name-only:*)",
      "Bash(node __SKILL__/scripts/inventory.cjs:*)",
      "Bash(node __LINK__/scripts/inventory.cjs:*)",
      "Bash(node __SKILL__/scripts/ledger-tool.cjs:*)",
      "Bash(node __LINK__/scripts/ledger-tool.cjs:*)",
      "Bash(node __SKILL__/scripts/validate-findings.cjs:*)",
      "Bash(node __LINK__/scripts/validate-findings.cjs:*)",
      "Bash(node __SKILL__/scripts/validate-coverage-ledger.cjs:*)",
      "Bash(node __LINK__/scripts/validate-coverage-ledger.cjs:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "ScheduleWakeup",
      "CronCreate",
      "RemoteTrigger",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(fork)",
      "Agent(statusline-setup)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets*.yaml)",
      "Read(**/secrets*.yml)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(__TARGET__/**)",
      "Write(__TARGET__/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Bash(rg *--pre*)",
      "Bash(rg *--search-zip*)",
      "Bash(rg -z*)",
      "Bash(rg * -z*)",
      "Bash(rg *--follow*)",
      "Bash(rg -L*)",
      "Bash(rg * -L*)",
      "Bash(git -c*)",
      "Bash(git show:*)",
      "Bash(git -C __TARGET__ show:*)",
      "Bash(git grep:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git reset:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(sh:*)",
      "Bash(bash:*)",
      "Bash(zsh:*)",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(cat:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(claude:*)",
      "Bash(codex:*)",
      "Bash(gemini:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "RIPGREP_CONFIG_PATH": "__SKILL__/rg-lean.conf",
    "SEC_LEAN_AGENT_CAP": "10"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh __SKILL__/scripts/agent-cap.sh"
          }
        ]
      }
    ]
  }
}
